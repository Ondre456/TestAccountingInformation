@model IEnumerable<TestAccountingInformation.DataBase.Entities.RequestEntity>

@{
    ViewData["Title"] = "Мои запросы";
}

<h2>Мои запросы</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Создать новый запрос</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Дата создания</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.CreatedAt.ToShortDateString()</td>
                <td>@item.Status.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Просмотр</a>
                </td>
            </tr>
        }
    </tbody>
</table>
