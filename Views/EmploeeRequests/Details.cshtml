@model TestAccountingInformation.DataBase.Entities.RequestEntity

@{
    ViewData["Title"] = "Детали запроса";
}

<h2>Запрос № @Model.Id</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Статус:</strong> @Model.Status.Status</p>
        <p><strong>Дата создания:</strong> @Model.CreatedAt</p>

        <p>
            <strong>Исполнитель:</strong>
            @if (Model.Executor != null)
            {
                @(Model.Executor.FirstName + " " + Model.Executor.LastName)
            }
            else
            {
                <span class="text-muted fst-italic">Пока не взято в работу</span>
            }
        </p>
        
        <div class="mb-3">
            <strong>Комментарий к запросу:</strong>
            @if (!string.IsNullOrEmpty(Model.ReasonComment))
            {
                <div class="border rounded p-2 bg-light">
                    @Model.ReasonComment
                </div>
            }
            else
            {
                <span class="text-muted fst-italic">Комментарий не указан</span>
            }
        </div>

        <h4>Список документов:</h4>
        <ul>
            @foreach (var reqInfo in Model.RequestInformations)
            {
                <li>@reqInfo.Information.Type (Кол-во: @reqInfo.Quantity)</li>
            }
        </ul>
    </div>
</div>

<a asp-action="MyRequests" class="btn btn-primary mt-3">Назад к списку</a>
