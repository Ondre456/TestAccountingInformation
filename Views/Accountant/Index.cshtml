@model List<TestAccountingInformation.DataBase.Entities.RequestEntity>

<h2>Список запросов</h2>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Автор</th>
            <th>Исполнитель</th>
            <th>Статус</th>
            <th>Создан</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var request in Model)
        {
            <tr>
                <td>@request.Id</td>
                <td>@request.Author?.FirstName @request.Author?.LastName</td>
                
                <td>
                    @if (request.Executor != null)
                    {
                        @(request.Executor.FirstName + " " + request.Executor.LastName)
                    }
                    else
                    {
                        <span class="text-muted">Пока не взято в работу</span>
                    }
                </td>

                <td>@request.Status.Status</td>
                <td>@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <a href="@Url.Action("Details", "Accountant", new { id = request.Id })" class="btn btn-primary">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>
